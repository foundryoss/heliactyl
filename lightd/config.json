{
  "server": {
    "host": "0.0.0.0",
    "port": 8070
  },
  "docker": {
    "socket_path": "/var/run/docker.sock"
  },
  "volumes": {
    "base_path": "./storage/volumes"
  },
  "storage": {
    "base_path": "./storage",
    "containers_path": "./storage/containers",
    "networks_path": "./storage/networks",
    "logs_path": "./storage/logs"
  },
  "containers": {
    "default_network": "lightd-network",
    "cleanup_timeout": 30,
    "max_containers": 100
  },
  "logging": {
    "level": "info",
    "file": "./storage/lightd.log"
  },
  "monitoring": {
    "enabled": true,
    "interval_ms": 1000,
    "ru_config": {
      "cpu_weight": 1.0,
      "memory_weight": 0.5,
      "io_weight": 2.0,
      "network_weight": 1.5,
      "storage_weight": 0.8,
      "base_ru": 0.1
    }
  }
}