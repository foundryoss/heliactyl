app:
  name: Heliactyl
  version: "15.0.0"

server:
  host: 0.0.0.0
  port: 8787
  basePath: /
  cors:
    origins: ["*"]
    allowCredentials: false
    allowHeaders: ["Content-Type", "Authorization"]
    allowMethods: ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]

security:
  sessionTtlSeconds: 60 * 60 * 24 * 7 # 7 days
  passwordHashing:
    algorithm: bcrypt
    bcryptRounds: 12
  # Use a 32+ byte key in production
  encryptionKey: "replace_with_32_byte_secret_key_minimum"

database:
  # Supported URL schemes:
  # - sqlite://./data/heliactyl.db
  # - postgres://user:pass@host:5432/dbname
  # - postgresql://user:pass@host:5432/dbname
  # - mysql://user:pass@host:3306/dbname
  # - mysql2://user:pass@host:3306/dbname
  url: sqlite://./data/heliactyl.db

redis:
  url: redis://127.0.0.1:6379
  namespace: heliactyl:v15
  allowInMemoryFallback: true

oauth:
  discord:
    enabled: false
    clientId: "YOUR_DISCORD_CLIENT_ID"
    clientSecret: "YOUR_DISCORD_CLIENT_SECRET"
    redirectUri: "http://localhost:8787/api/auth/discord/callback"
    scopes: ["identify", "email"]

pterodactyl:
  url: https://panel.example.com
  apiKey: "REPLACE_WITH_API_KEY"
  clientKey: "REPLACE_WITH_CLIENT_KEY"
  reconcileIntervalMinutes: 30
  eggSyncIntervalMinutes: 10

jobs:
  enabled: true
  startupRun: true
  eggSyncIntervalMinutes: 10
  reconcileIntervalMinutes: 30

packages:
  defaultPackage: default
  maxTenantsDefault: 2
  items:
    default:
      memoryMb: 4096
      diskMb: 10240
      cpuPercent: 200
      serverSlots: 2
    pro:
      memoryMb: 8192
      diskMb: 20480
      cpuPercent: 400
      serverSlots: 5

locations:
  - { id: 1, slug: "us-east-1", name: "US East" }
  - { id: 2, slug: "eu-central-1", name: "EU Central", lockedPackage: "default" }


